<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickPing" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/peyda_regular</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/quickping_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/quickping_black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/quickping_blue</item>
    </style>

    <style name="Theme.QuickPing.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nimhub_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.QuickPing</item>
    </style>
</resources>
